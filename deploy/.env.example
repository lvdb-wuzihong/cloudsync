# cloud-syncer local dev config template.
# Copy to .env (repo root) and fill real values; .env is git-ignored.
# Precedence: real env vars > .env > defaults in cloudsync/core/config.py.
#
# SECURITY: only plain KEY=VALUE settings belong here.
# Cloud credentials NEVER go in .env - they live in accounts.yaml
# (K8s Secret mount in prod, CLOUDSYNC_ACCOUNTS_FILE points to it).

# ── Database (bingops shared PostgreSQL) ────────────────────────────────────
CLOUDSYNC_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bingops

# ── Kafka ────────────────────────────────────────────────────────────────────
CLOUDSYNC_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Optional explicit topic list; empty = derive cloud-sync-{provider} per adapter
CLOUDSYNC_KAFKA_TOPICS=
CLOUDSYNC_KAFKA_TOPIC_PARTITIONS=3
CLOUDSYNC_KAFKA_TOPIC_REPLICATION_FACTOR=1

# ── Credentials file ─────────────────────────────────────────────────────────
CLOUDSYNC_ACCOUNTS_FILE=deploy/accounts.example.yaml

# ── Scheduler ────────────────────────────────────────────────────────────────
CLOUDSYNC_TASK_RELOAD_INTERVAL=60
CLOUDSYNC_SLOW_ROUND_RATIO=0.8

# ── Logging ──────────────────────────────────────────────────────────────────
CLOUDSYNC_DEBUG=true
CLOUDSYNC_LOG_LEVEL=INFO
# Uncomment to enable the file log channel (JSON lines, daily gzip rotation)
# CLOUDSYNC_LOG_DIR=logs
CLOUDSYNC_LOG_RETENTION_DAYS=7
